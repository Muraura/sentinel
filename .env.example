POSTGRES_USER=sentinel
POSTGRES_PASSWORD=change-me
POSTGRES_DB=sentinel
DATABASE_URL=postgresql://sentinel:change-me@localhost:5433/sentinel

# Your own key from https://console.anthropic.com/settings/keys (used instead of any key in your shell)
ANTHROPIC_API_KEY=

# Backup model, used only when Claude is unavailable. Must support tool calling.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=
OLLAMA_NUM_CTX=32768

# API users: key:name:role, comma-separated. Roles: analyst, approver, admin
SENTINEL_API_USERS=

# Free hosted model for the public demo: key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
